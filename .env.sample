# Copy this file to .env and replace each xxx placeholder with your own value.
# Never commit .env or share real credentials.

# Required: Groq chat model used by Guardrails and direct-Groq mode
GROQ_API_KEY=xxx

# Required: Qdrant connection used for ingestion and retrieval
QDRANT_URL=https://xxx.cloud.qdrant.io:6333
QDRANT_API_KEY=xxx

# Optional hosted embeddings. Comment out if using the local
# all-mpnet-base-v2 fallback. Keep vector dimensions consistent between
# indexing and query-time retrieval.
# GEMINI_API_KEY=xxx

# Optional model overrides (defaults shown in app/config.py)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Optional: set this to enable Portkey instead of direct Groq calls.
# Configure matching "rag" and "brag" virtual-key aliases in Portkey.
# PORTKEY_API_KEY=xxx
# GROQ_FALLBACK_API_KEY=xxx

# Optional: Logfire telemetry.
# The API/UI use LOGFIRE_TOKEN; ingestion also accepts LOGFIRE_API_KEY if it
# has the project's "Send telemetry" permission.
# LOGFIRE_TOKEN=xxx
# LOGFIRE_API_KEY=xxx

# Optional: LangSmith tracing. Tracing is disabled if the API key is absent.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=xxx
LANGSMITH_PROJECT=rag_scale_test
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional: separate Groq key for evaluation judge calls.
# JUDGE_GROQ=xxx

# Optional: Streamlit chat UI backend; defaults to http://localhost:8000.
BACKEND_URL=http://localhost:8000
